-- imposters/yml/nested/routes.imp.yml --
- request:
    method: POST
    endpoint: /yml/{id:[0-9]+}
    schemaFile: schemas/request.json
    headers:
      X-Key: ^token$
    params:
      color: red
  response:
    status: 201
    headers:
      Content-Type: text/plain
      X-Source: yml
    bodyFile: responses/body.txt
- request:
    method: POST
    endpoint: /yml/{id}
  response:
    status: 400
    headers:
      Content-Type: text/plain
    body: "fallback\n"
-- imposters/yml/nested/schemas/request.json --
{"type": "object", "properties": {"name": {"type": "string"}}, "required": ["name"]}
-- imposters/yml/nested/responses/body.txt --
yml file body
-- imposters/yaml/nested/routes.imp.yaml --
- request:
    method: POST
    endpoint: /yaml/{id:[0-9]+}
    schemaFile: schemas/request.json
    headers:
      X-Key: ^token$
    params:
      color: red
  response:
    status: 201
    headers:
      Content-Type: text/plain
      X-Source: yaml
    bodyFile: responses/body.txt
- request:
    method: POST
    endpoint: /yaml/{id}
  response:
    status: 400
    headers:
      Content-Type: text/plain
    body: "fallback\n"
-- imposters/yaml/nested/schemas/request.json --
{"type": "object", "properties": {"name": {"type": "string"}}, "required": ["name"]}
-- imposters/yaml/nested/responses/body.txt --
