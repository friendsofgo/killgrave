-- imposters/routes.imp.json --
[{"request": {"method": "POST", "endpoint": "/mock"}, "response": {"status": 200, "headers": {"Content-Type": "text/plain"}, "body": "mocked\n"}}, {"request": {"method": "POST", "endpoint": "/submit", "schemaFile": "schemas/gopher.json"}, "response": {"status": 201, "headers": {"Content-Type": "text/plain"}, "body": "gopher\n"}}]
-- imposters/schemas/gopher.json --
{"type": "object", "properties": {"type": {"enum": ["gopher"]}}, "required": ["type"]}
-- config.yml --
host: localhost
port: ${PORT}
imposters_path: imposters
proxy:
  mode: missing
  url: ${UPSTREAM}
-- scenario.json --
{
  "upstreamCalls": 2,
  "args": [
    "--config",
    "config.yml"
  ]
}
