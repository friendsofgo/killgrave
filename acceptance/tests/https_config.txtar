-- imposters/routes.imp.json --
[
  {
    "request": {
      "method": "GET",
      "endpoint": "/secure"
    },
    "response": {
      "status": 200,
      "headers": {
        "Content-Type": "text/plain"
      },
      "body": "secure\n"
    }
  }
]
-- config.yml --
host: localhost
port: ${PORT}
imposters_path: imposters
secure: true
-- scenario.json --
{
  "https": true,
  "args": [
    "--config",
    "config.yml"
  ]
}
-- http/matched/req.http --
GET /secure HTTP/1.1

-- http/matched/res.http --
HTTP/1.1 200 OK
Content-Length: 7
Content-Type: text/plain


secure
-- http/unmatched/req.http --
